{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["exports", "types", "duplicates"],
  "ignoreBinaries": ["supabase", "psql", "electron-forge"],
  "ignoreFiles": [
    "api/**/*.js",
    "packages/desktop/src/preload.cjs",
    "server/scripts/cleanup-test-fixtures.ts",
