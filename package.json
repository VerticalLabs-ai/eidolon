{
  "name": "eidolon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter server dev",
    "dev:ui": "pnpm --filter ui dev",
    "desktop:dev": "pnpm --filter @eidolon/desktop dev",
    "desktop:package": "pnpm --filter @eidolon/desktop package",
    "desktop:make": "pnpm --filter @eidolon/desktop make",
    "desktop:make:mac": "pnpm --filter @eidolon/desktop make:mac",
    "build": "pnpm --filter @eidolon/shared build && pnpm --filter @eidolon/db build && pnpm --filter server build && pnpm --filter ui build",
    "build:vercel": "pnpm --filter @eidolon/shared build && pnpm --filter @eidolon/db build && pnpm --filter server build && pnpm --filter @eidolon/db migrate && pnpm --filter ui build",
    "typecheck": "tsc -b",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/check-format.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "labels:check": "node scripts/sync-labels.mjs",
    "labels:sync": "node scripts/sync-labels.mjs --sync",
    "backlog:health": "node scripts/backlog-health.mjs",
    "duplication": "jscpd . --config .jscpd.json",
    "dead-code": "knip --no-progress",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --no-seed && pnpm --filter @eidolon/db migrate",
    "db:generate": "pnpm --filter @eidolon/db generate",
    "db:migrate": "pnpm --filter @eidolon/db migrate",
    "clean": "rm -rf node_modules packages/*/node_modules server/node_modules ui/node_modules",
    "cleanup:fixtures": "pnpm --filter server exec tsx scripts/cleanup-test-fixtures.ts",
    "promote": "bash scripts/promote-to-main.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jscpd": "^4.2.5",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@electron/rebuild": "^4.2.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,yaml,yml,md}": "prettier --write",
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix"
  }
}
