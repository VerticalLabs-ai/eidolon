{
  "name": "eidolon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter server dev",
    "dev:ui": "pnpm --filter ui dev",
    "desktop:dev": "pnpm --filter @eidolon/desktop dev",
    "desktop:package": "pnpm --filter @eidolon/desktop package",
    "desktop:make": "pnpm --filter @eidolon/desktop make",
    "desktop:make:mac": "pnpm --filter @eidolon/desktop make:mac",
    "build": "pnpm --filter @eidolon/shared build && pnpm --filter @eidolon/db build && pnpm --filter server build && pnpm --filter ui build",
    "build:vercel": "pnpm --filter @eidolon/shared build && pnpm --filter @eidolon/db build && pnpm --filter server build && pnpm --filter @eidolon/db migrate && pnpm --filter ui build",
    "typecheck": "tsc -b",
    "lint": "eslint . --report-unused-disable-directives",
    "test": "vitest",
    "test:run": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --no-seed && pnpm --filter @eidolon/db migrate",
    "db:generate": "pnpm --filter @eidolon/db generate",
    "db:migrate": "pnpm --filter @eidolon/db migrate",
    "clean": "rm -rf node_modules packages/*/node_modules server/node_modules ui/node_modules",
    "promote": "bash scripts/promote-to-main.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ]
  }
}
